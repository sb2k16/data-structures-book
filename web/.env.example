# Newsletter. Without this the signup form does not render — better than
# silently dropping addresses. Point it at Buttondown / ConvertKit / Formspree.
PUBLIC_NEWSLETTER_ENDPOINT=

# Ads. Leave off until the site has traffic worth selling: at launch, display
# ads earn ~nothing on a developer audience (heavy ad-blocking, low RPM) while
# measurably suppressing the sharing that gets you to the traffic where they
# would pay. See src/components/AdSlot.astro.
PUBLIC_ADS_ENABLED=false
PUBLIC_ETHICALADS_PUBLISHER=

# Companion practice platform. Set to Codexa's URL to show "Practice on Codexa"
# CTAs at the end of chapters; leave empty and they don't render.
PUBLIC_CODEXA_URL=

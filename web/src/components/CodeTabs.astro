---
/**
 * Tabbed, multi-language prose code block for MDX chapters. Emits the exact
 * .code-tabs / .ct-bar / .ct-tab / .ct-panel markup that the rehypeCodeTabs
 * plugin produces for plain-markdown chapters, so a single shared style + script
 * (in Chapter.astro) drives both. Snippets are highlighted at build time by the
 * same Shiki themes as the book's fenced code. The visible language is the
 * page-wide preference shared with the runnable CodeProblem editor.
 *
 *   <CodeTabs snippets={[{ lang: 'cpp', code: `...` }, { lang: 'py', code: `...` }]} />
 */
import { Code } from 'astro:components';

type Lang = 'cpp' | 'py' | 'java' | 'go';
interface Snippet { lang: Lang; code: string; }
const { snippets } = Astro.props as { snippets: Snippet[] };

const LABEL: Record<Lang, string> = { cpp: 'C++', py: 'Python', java: 'Java', go: 'Go' };
const SHIKI: Record<Lang, string> = { cpp: 'cpp', py: 'python', java: 'java', go: 'go' };
const ORDER: Lang[] = ['cpp', 'py', 'java', 'go'];
const items = [...snippets].sort((a, b) => ORDER.indexOf(a.lang) - ORDER.indexOf(b.lang));
---

<div class="code-tabs">
  <div class="ct-bar" role="tablist">
    {items.map((s) => (
      <button class="ct-tab" type="button" role="tab" data-lang={s.lang} aria-selected={s.lang === 'cpp' ? 'true' : 'false'}>
        {LABEL[s.lang]}
      </button>
    ))}
  </div>
  {items.map((s) => (
    <div class="ct-panel" data-lang={s.lang} hidden={s.lang !== 'cpp'}>
      <Code code={s.code} lang={SHIKI[s.lang] as any} themes={{ light: 'github-light', dark: 'github-dark' }} wrap={false} />
    </div>
  ))}
</div>

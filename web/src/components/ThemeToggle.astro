---
---
<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle color theme"
  class="rounded-md p-2 transition-colors"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" class="sun-core"></circle>
    <g class="sun-rays">
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </g>
    <path class="moon" d="M20 14.5A8 8 0 019.5 4 8.5 8.5 0 1020 14.5z" fill="currentColor" stroke="none"></path>
  </svg>
</button>

<style>
  #theme-toggle { color: var(--text-muted); }
  #theme-toggle:hover { color: var(--text-primary); background: var(--surface-3); }
  .moon { display: none; }
  :global(:root[data-theme='dark']) .sun-core,
  :global(:root[data-theme='dark']) .sun-rays { display: none; }
  :global(:root[data-theme='dark']) .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun-core,
    :global(:root:not([data-theme='light'])) .sun-rays { display: none; }
    :global(:root:not([data-theme='light'])) .moon { display: block; }
  }
</style>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const current =
      root.dataset.theme ??
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

---
import Base from '../layouts/Base.astro';

const DESC =
  'Data Structures on Systems is free and open source. If it helped you see the machine underneath the code, chip in to keep it free, ad-light, and growing.';

// Stripe Payment Link (donor chooses the amount), from PUBLIC_STRIPE_DONATE_URL.
// There is deliberately no fallback: a test-mode link (buy.stripe.com/test_...)
// renders a TEST MODE banner and declines every real card, so shipping one is
// worse than shipping no button at all — the reader tries to give and can't.
// Unset, or set to a test link in a production build, degrades to the
// "other ways to help" state instead.
const RAW_DONATE_URL = import.meta.env.PUBLIC_STRIPE_DONATE_URL ?? '';
const IS_TEST_LINK = RAW_DONATE_URL.includes('buy.stripe.com/test_');
const DONATE_URL = !RAW_DONATE_URL || (IS_TEST_LINK && import.meta.env.PROD) ? null : RAW_DONATE_URL;

const TIERS = [
  { amount: '$5', name: 'Buy a coffee', blurb: 'A small thanks that keeps the lights on.', mid: false },
  { amount: '$15', name: 'Keep it free', blurb: 'Covers hosting and the compiler that runs your code.', mid: true },
  { amount: '$50', name: 'Fund a chapter', blurb: 'Helps commission new chapters and visualizations.', mid: false },
];
---

<Base title="Support — Data Structures on Systems" description={DESC}>
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-6 sm:pt-24">
    <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted)">
      Support the book
    </div>
    <h1 class="mt-3 text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl" style="color: var(--text-primary)">
      Free, and staying that way.
    </h1>
    <p class="mt-6 text-lg leading-relaxed" style="color: var(--text-secondary)">
      <strong style="color: var(--text-primary)">Data Structures on Systems</strong> is free and open
      source — no paywall, no sign-up, no course upsell. If it helped you see the machine underneath the
      code — the cache line, the B-tree, the write path of a real database — you can chip in to keep it
      free, keep the ads light, and help new chapters get written.
    </p>
    <p class="mt-3 leading-relaxed" style="color: var(--text-secondary)">
      Every dollar goes to the two things that keep it running: hosting, and the public compiler service
      that runs your code and benchmarks in the browser. Give once, any amount.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-6">
    <div class="grid gap-4 sm:grid-cols-3">
      {TIERS.map((t) => {
        const Tag = DONATE_URL ? 'a' : 'div';
        return (
          <Tag
            href={DONATE_URL ?? undefined}
            target={DONATE_URL ? '_blank' : undefined}
            rel={DONATE_URL ? 'noopener' : undefined}
            class="group flex flex-col rounded-xl border p-5 no-underline transition-colors"
            style={`border-color: ${t.mid ? 'var(--accent)' : 'var(--border)'}; background: ${t.mid ? 'color-mix(in srgb, var(--accent) 6%, var(--surface-1))' : 'var(--surface-1)'}`}
          >
            <div class="text-2xl font-bold" style="color: var(--text-primary)">{t.amount}</div>
            <div class="mt-1 text-sm font-semibold" style={`color: ${t.mid ? 'var(--accent)' : 'var(--text-primary)'}`}>{t.name}</div>
            <p class="mt-2 text-sm leading-snug" style="color: var(--text-muted)">{t.blurb}</p>
          </Tag>
        );
      })}
    </div>

    <div class="mt-8 flex flex-col items-start gap-3">
      {DONATE_URL ? (
        <>
          <a
            href={DONATE_URL}
            target="_blank"
            rel="noopener"
            class="rounded-lg px-5 py-3 text-base font-semibold no-underline"
            style="background: var(--accent); color: #fff"
          >
            Support the book →
          </a>
          <p class="text-xs" style="color: var(--text-muted)">
            Secure checkout via Stripe · one-time · choose your own amount. No account needed.
          </p>
        </>
      ) : (
        <p class="text-sm leading-relaxed" style="color: var(--text-muted)">
          Donations open shortly — checkout isn't live yet. In the meantime, the ways to help below
          are worth just as much.
        </p>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-24 pt-6">
    <div class="rounded-xl border p-6" style="border-color: var(--border); background: var(--surface-2)">
      <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted)">
        Other ways to help
      </div>
      <ul class="mt-3 flex flex-col gap-2 text-sm leading-relaxed" style="color: var(--text-secondary)">
        <li>★ <a href="https://github.com/sb2k16/data-structures-book" target="_blank" rel="noopener" style="color: var(--accent)">Star or fork it on GitHub</a> — visibility is worth as much as a donation.</li>
        <li>✎ Found a bug or a rough explanation? Open an issue or a PR. Contributions are welcome.</li>
        <li>↗ Share a chapter with someone learning systems — that's the best support there is.</li>
      </ul>
    </div>
  </section>
</Base>

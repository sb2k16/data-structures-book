---
import Base from '../layouts/Base.astro';
import CodeProblem from '../components/problem/CodeProblem';
import { practiceProblems } from '../lib/practiceProblems';

const DESC =
  'Concept-check practice problems for Data Structures on Systems — short, original exercises that confirm you understood the ideas in the book. Solve them in C++, Python, Java, or Go, run right in your browser.';

// The concept string is authored as "Topic - explanation (Chapter: X)"; show the
// human half without the parenthetical chapter tag.
const conceptText = (c: string) => c.replace(/\s*\(Chapter:[^)]*\)\s*$/, '');
---

<Base title="Practice Problems — Data Structures on Systems" description={DESC}>
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-10 sm:pt-20">
    <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted)">
      End of the book · {practiceProblems.length} problems
    </div>
    <h1 class="mt-3 text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl" style="color: var(--text-primary)">
      Practice problems
    </h1>
    <p class="mt-5 text-lg leading-relaxed" style="color: var(--text-secondary)">
      These aren't interview brain-teasers. Each is a small, original check that you understood
      one idea from the book — sum an array, walk a linked list, recurse over a tree. Fill in the
      function and run it. Pick your language with the tabs; it applies to every problem on the page.
    </p>
    <p class="mt-3 text-sm" style="color: var(--text-muted)">
      Everything compiles and runs in your browser on a public compiler service — no account, nothing installed.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-24">
    {practiceProblems.map((p, i) => (
      <div class="border-t pt-8 pb-2" style="border-color: var(--border)">
        <div class="flex items-baseline gap-3">
          <span class="font-mono text-sm tabular-nums" style="color: var(--text-muted)">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="text-xl font-semibold" style="color: var(--text-primary)">{p.title}</h2>
        </div>
        <p class="mt-2 leading-relaxed" style="color: var(--text-secondary)">{p.blurb}</p>
        <p class="mt-1 text-xs" style="color: var(--text-muted)">{conceptText(p.concept)}</p>
        <CodeProblem client:visible problem={p.languages} />
      </div>
    ))}
  </section>
</Base>

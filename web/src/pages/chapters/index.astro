---
import Base from '../../layouts/Base.astro';
import { byPart, CHAPTERS } from '../../lib/book';

const parts = byPart();
---
<Base
  title="All chapters"
  description={`All ${CHAPTERS.length} chapters of Data Structures on Systems — a free, MIT-licensed book on how modern software systems actually use data structures, in C++.`}
>
  <div class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl" style="color: var(--text-primary)">Contents</h1>
    <p class="mt-3 text-base leading-relaxed" style="color: var(--text-secondary)">
      Six parts, {CHAPTERS.length} chapters. Read them in order, or start with
      <a href="/chapters/memory-hierarchy" class="underline" style="color: var(--accent)">the memory hierarchy</a>,
      which is the one that changes how the rest of them read.
    </p>

    <div class="mt-12 space-y-12">
      {parts.map((group, i) => (
        <section>
          <h2 class="mb-5 text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted)">
            Part {['I', 'II', 'III', 'IV', 'V', 'VI'][i]} · {group.part}
          </h2>
          <ol class="space-y-5">
            {group.chapters.map((c) => (
              <li>
                <a href={`/chapters/${c.slug}`} class="group no-underline">
                  <div class="flex items-baseline gap-3">
                    <span class="w-8 shrink-0 text-sm tabular-nums" style="color: var(--text-muted)">{c.number}</span>
                    <span class="text-base font-semibold" style="color: var(--text-primary)">{c.title}</span>
                    {c.custom && (
                      <span
                        class="rounded px-1.5 py-0.5 text-[11px] font-semibold"
                        style="background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent)"
                      >
                        Interactive
                      </span>
                    )}
                  </div>
                  <p class="mt-1 pl-11 text-sm leading-relaxed" style="color: var(--text-secondary)">{c.blurb}</p>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import EmailCapture from '../components/EmailCapture.astro';
import Compare from '../components/bench/Compare';
import { byPart, CHAPTERS } from '../lib/book';

const parts = byPart();
const DESC =
  'A free, open-source book on data structures and algorithms in C++ — how they behave on real hardware and how production systems like Redis, Postgres, and OpenSearch actually use them. With benchmarks you run in your browser.';
---
<Base title="Data Structures on Systems" description={DESC}>
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-8 sm:pt-24">
    <div class="max-w-3xl">
      <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted)">
        Free · MIT licensed · {CHAPTERS.length} chapters
      </div>
      <h1 class="mt-3 text-4xl font-bold leading-[1.1] tracking-tight sm:text-6xl" style="color: var(--text-primary)">
        Data structures, down to the cache line and out to the cluster.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed" style="color: var(--text-secondary)">
        Most books stop at Big-O. This one shows what the machine actually does — cache misses,
        memory layout, branch predictors — and how the systems you use every day, from Redis to
        OpenSearch, turn these structures into infrastructure that scales.
      </p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed" style="color: var(--text-secondary)">
        Below are two loops with identical complexity. Run them on your own hardware.
      </p>
    </div>

    <div class="mt-8 max-w-3xl">
      <Compare
        client:load
        bench="seqVsRand"
        title="Same operations. Same asymptotics. Same code path."
        blurb="Two pointer chases over an identical 32 MiB array. One follows i → i+1; the other follows a random cycle. Big-O calls both O(n) and cannot tell them apart."
        seconds={4}
        unit="ns per access"
      />
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/chapters/memory-hierarchy"
        class="rounded-lg px-5 py-2.5 text-sm font-semibold no-underline"
        style="background: var(--accent); color: #fff"
      >
        Read the chapter that explains it →
      </a>
      <a
        href="/chapters"
        class="rounded-lg border px-5 py-2.5 text-sm font-semibold no-underline"
        style="border-color: var(--border-strong); color: var(--text-primary)"
      >
        All {CHAPTERS.length} chapters
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-10 sm:grid-cols-3">
      <div>
        <h2 class="text-base font-semibold" style="color: var(--text-primary)">From the cache line to the cluster</h2>
        <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-secondary)">
          Each structure is followed from what the CPU does with it — cache, memory layout, branch
          prediction — up to how it shards across a fleet of machines. The span no other DSA book covers.
        </p>
      </div>
      <div>
        <h2 class="text-base font-semibold" style="color: var(--text-primary)">Measured, not asserted</h2>
        <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-secondary)">
          The benchmarks run in your browser, on your CPU, while you read. No screenshots of someone
          else's laptop, and no numbers you have to take on faith.
        </p>
      </div>
      <div>
        <h2 class="text-base font-semibold" style="color: var(--text-primary)">Connected to production</h2>
        <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-secondary)">
          Every chapter ends where the structure actually ships — Redis, Postgres, the Linux kernel,
          OpenSearch shard routing — in modern C++ that compiles, with the invariants and failure modes
          spelled out in <a href="/chapters" class="underline">every chapter</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-8">
    <h2 class="text-2xl font-bold tracking-tight" style="color: var(--text-primary)">The book</h2>
    <p class="mt-2 text-sm" style="color: var(--text-muted)">
      {CHAPTERS.length} chapters, about 600 pages. Free forever.
    </p>

    <div class="mt-10 space-y-12">
      {parts.map((group) => (
        <div>
          <h3 class="mb-4 text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted)">
            {group.part}
          </h3>
          <div class="grid gap-3 sm:grid-cols-2">
            {group.chapters.map((c) => (
              <a
                href={`/chapters/${c.slug}`}
                class="rounded-xl border p-4 no-underline transition-colors hover:bg-[var(--surface-2)]"
                style="border-color: var(--border)"
              >
                <div class="flex items-baseline gap-2.5">
                  <span class="text-xs tabular-nums" style="color: var(--text-muted)">{c.number}</span>
                  <span class="text-sm font-semibold leading-snug" style="color: var(--text-primary)">
                    {c.title}
                  </span>
                </div>
                <p class="mt-1.5 text-sm leading-relaxed" style="color: var(--text-secondary)">{c.blurb}</p>
                {c.custom && (
                  <span
                    class="mt-2.5 inline-block rounded px-1.5 py-0.5 text-[11px] font-semibold"
                    style="background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent)"
                  >
                    Interactive
                  </span>
                )}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <EmailCapture />
  </section>
</Base>

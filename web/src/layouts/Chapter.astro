---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import EmailCapture from '../components/EmailCapture.astro';
import PracticeOnCodexa from '../components/PracticeOnCodexa.astro';
import { neighbors, type ChapterMeta } from '../lib/book';
import type { MarkdownHeading } from 'astro';

interface Props {
  chapter: ChapterMeta;
  headings: MarkdownHeading[];
  /** Overrides the chapter blurb for the meta description. */
  description?: string;
}

const { chapter, headings, description } = Astro.props;
const { prev, next } = neighbors(chapter.slug);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base title={`${chapter.title}`} description={description ?? chapter.blurb} article>
  <div class="mx-auto max-w-6xl px-5 py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-12">
    <article class="min-w-0">
      <header class="mb-10">
        <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted)">
          Chapter {chapter.number} · {chapter.part}
        </div>
        <h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight sm:text-4xl" style="color: var(--text-primary)">
          {chapter.title}
        </h1>
        <p class="mt-3 max-w-2xl text-base leading-relaxed" style="color: var(--text-secondary)">
          {chapter.blurb}
        </p>
      </header>

      <div class="prose">
        <slot />
      </div>

      <nav class="mt-20 grid gap-3 sm:grid-cols-2">
        {prev ? (
          <a
            href={`/chapters/${prev.slug}`}
            class="rounded-xl border p-4 no-underline transition-colors hover:bg-[var(--surface-2)]"
            style="border-color: var(--border)"
          >
            <div class="text-xs" style="color: var(--text-muted)">← Chapter {prev.number}</div>
            <div class="mt-1 text-sm font-semibold" style="color: var(--text-primary)">{prev.title}</div>
          </a>
        ) : <div />}
        {next && (
          <a
            href={`/chapters/${next.slug}`}
            class="rounded-xl border p-4 text-right no-underline transition-colors hover:bg-[var(--surface-2)] sm:col-start-2"
            style="border-color: var(--border)"
          >
            <div class="text-xs" style="color: var(--text-muted)">Chapter {next.number} →</div>
            <div class="mt-1 text-sm font-semibold" style="color: var(--text-primary)">{next.title}</div>
          </a>
        )}
      </nav>

      <div class="mt-10">
        <PracticeOnCodexa topic={chapter.slug} />
      </div>

      <div class="mt-8">
        <EmailCapture />
      </div>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
        {toc.length > 2 && (
          <>
            <div class="mb-3 text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted)">
              On this page
            </div>
            <ul class="space-y-1.5 text-sm">
              {toc.map((h) => (
                <li style={`padding-left: ${(h.depth - 2) * 0.75}rem`}>
                  <a
                    href={`#${h.slug}`}
                    class="block no-underline leading-snug transition-colors hover:text-[var(--text-primary)]"
                    style="color: var(--text-muted)"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
        <AdSlot placement="sidebar" />
      </div>
    </aside>
  </div>
</Base>

<!-- Multi-language code tabs: shared styles + one driver for both the rehype
     grouping (markdown chapters) and the <CodeTabs> component (MDX chapters).
     Bound to the page-wide language preference used by the runnable editor. -->
<style is:global>
  .code-tabs { margin: 1.5rem 0; border: 1px solid var(--border); border-radius: 0.75rem; overflow: hidden; background: var(--surface-2); }
  .code-tabs .ct-bar { display: flex; align-items: center; gap: 0.25rem; border-bottom: 1px solid var(--border); padding: 0.4rem 0.6rem; }
  .code-tabs .ct-tab { border: 0; background: transparent; cursor: pointer; border-radius: 0.375rem; padding: 0.25rem 0.625rem; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.01em; color: var(--text-muted); }
  .code-tabs .ct-tab[aria-selected='true'] { background: var(--accent); color: #fff; }
  .code-tabs .ct-panel[hidden] { display: none; }
  .code-tabs .ct-panel :where(pre.astro-code) { margin: 0; border-radius: 0; }
</style>
<script>
  // Drives every .code-tabs on the page off the shared `dsos-lang` preference
  // (same key/event as langStore.ts), so a tab switch here, in another block,
  // or in the runnable editor all stay in lockstep. Runs once per page.
  const KEY = 'dsos-lang';
  const cur = (): string => { try { return localStorage.getItem(KEY) || 'cpp'; } catch { return 'cpp'; } };
  const apply = (root: Element, lang: string) => {
    const panels = [...root.querySelectorAll<HTMLElement>('.ct-panel')];
    const eff = panels.some((p) => p.dataset.lang === lang) ? lang : 'cpp';
    panels.forEach((p) => { p.hidden = p.dataset.lang !== eff; });
    root.querySelectorAll<HTMLElement>('.ct-tab').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.lang === eff)));
  };
  const applyAll = () => document.querySelectorAll('.code-tabs').forEach((r) => apply(r, cur()));
  document.querySelectorAll('.code-tabs').forEach((root) => {
    apply(root, cur());
    root.querySelectorAll<HTMLElement>('.ct-tab').forEach((t) =>
      t.addEventListener('click', () => {
        try { localStorage.setItem(KEY, t.dataset.lang!); } catch {}
        window.dispatchEvent(new CustomEvent('dsos-lang-change'));
      }));
  });
  window.addEventListener('dsos-lang-change', applyAll);
  window.addEventListener('storage', applyAll);
</script>

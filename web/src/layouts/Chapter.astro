---
import Base from './Base.astro';
import AdSlot from '../components/AdSlot.astro';
import EmailCapture from '../components/EmailCapture.astro';
import PracticeOnCodexa from '../components/PracticeOnCodexa.astro';
import { neighbors, type ChapterMeta } from '../lib/book';
import type { MarkdownHeading } from 'astro';

interface Props {
  chapter: ChapterMeta;
  headings: MarkdownHeading[];
  /** Overrides the chapter blurb for the meta description. */
  description?: string;
}

const { chapter, headings, description } = Astro.props;
const { prev, next } = neighbors(chapter.slug);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base title={`${chapter.title}`} description={description ?? chapter.blurb} article>
  <div class="mx-auto max-w-6xl px-5 py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-12">
    <article class="min-w-0">
      <header class="mb-10">
        <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted)">
          Chapter {chapter.number} · {chapter.part}
        </div>
        <h1 class="mt-2 text-3xl font-bold leading-tight tracking-tight sm:text-4xl" style="color: var(--text-primary)">
          {chapter.title}
        </h1>
        <p class="mt-3 max-w-2xl text-base leading-relaxed" style="color: var(--text-secondary)">
          {chapter.blurb}
        </p>
      </header>

      <div class="prose">
        <slot />
      </div>

      <nav class="mt-20 grid gap-3 sm:grid-cols-2">
        {prev ? (
          <a
            href={`/chapters/${prev.slug}`}
            class="rounded-xl border p-4 no-underline transition-colors hover:bg-[var(--surface-2)]"
            style="border-color: var(--border)"
          >
            <div class="text-xs" style="color: var(--text-muted)">← Chapter {prev.number}</div>
            <div class="mt-1 text-sm font-semibold" style="color: var(--text-primary)">{prev.title}</div>
          </a>
        ) : <div />}
        {next && (
          <a
            href={`/chapters/${next.slug}`}
            class="rounded-xl border p-4 text-right no-underline transition-colors hover:bg-[var(--surface-2)] sm:col-start-2"
            style="border-color: var(--border)"
          >
            <div class="text-xs" style="color: var(--text-muted)">Chapter {next.number} →</div>
            <div class="mt-1 text-sm font-semibold" style="color: var(--text-primary)">{next.title}</div>
          </a>
        )}
      </nav>

      <div class="mt-10">
        <PracticeOnCodexa topic={chapter.slug} />
      </div>

      <div class="mt-8">
        <EmailCapture />
      </div>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
        {toc.length > 2 && (
          <>
            <div class="mb-3 text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted)">
              On this page
            </div>
            <ul class="space-y-1.5 text-sm">
              {toc.map((h) => (
                <li style={`padding-left: ${(h.depth - 2) * 0.75}rem`}>
                  <a
                    href={`#${h.slug}`}
                    class="block no-underline leading-snug transition-colors hover:text-[var(--text-primary)]"
                    style="color: var(--text-muted)"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
        <AdSlot placement="sidebar" />
      </div>
    </aside>
  </div>
</Base>

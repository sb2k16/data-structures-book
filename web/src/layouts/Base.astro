---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { REPO_URL } from '../lib/book';

interface Props {
  title: string;
  description: string;
  /** Article pages get Article schema and an author byline. */
  article?: boolean;
  ogImage?: string;
}

const { title, description, article = false, ogImage = '/og-default.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
const SITE = 'Data Structures on Systems';

const schema = {
  '@context': 'https://schema.org',
  '@type': article ? 'TechArticle' : 'Book',
  name: title,
  headline: title,
  description,
  url: canonical.href,
  author: { '@type': 'Person', name: 'Souvik Bhattacherjee' },
  ...(article ? {} : { numberOfPages: 600, inLanguage: 'en', isAccessibleForFree: true }),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE ? title : `${title} — ${SITE}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:site_name" content={SITE} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

    {/* Applied before first paint so the page never flashes the wrong theme. */}
    <script is:inline>
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || stored === 'light') {
        document.documentElement.dataset.theme = stored;
      }
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:px-3 focus:py-2"
      style="background: var(--surface-1); color: var(--text-primary)"
    >
      Skip to content
    </a>

    <header
      class="sticky top-0 z-40 border-b backdrop-blur"
      style="border-color: var(--border); background: color-mix(in srgb, var(--surface-1) 88%, transparent)"
    >
      <nav class="mx-auto flex max-w-6xl items-center gap-6 px-5 py-3.5">
        <a href="/" class="flex items-center gap-2 text-sm font-semibold no-underline" style="color: var(--text-primary)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="2" y="8" width="20" height="8" rx="1.5" stroke="var(--accent)" stroke-width="1.8" />
            <path d="M7 8v8M12 8v8M17 8v8" stroke="var(--accent)" stroke-width="1.8" />
          </svg>
          <span class="hidden sm:inline">Data Structures on Systems</span>
          <span class="sm:hidden">Data Structures</span>
        </a>

        {/* Below `sm` only Chapters and the toggle survive; three links plus the
            wordmark overflow a 390px viewport. */}
        <div class="ml-auto flex items-center gap-1 text-sm">
          <a href="/chapters" class="rounded-md px-2.5 py-1.5 no-underline transition-colors hover:bg-[var(--surface-3)] sm:px-3" style="color: var(--text-secondary)">
            Chapters
          </a>
          <a href="/chapters/memory-hierarchy" class="hidden rounded-md px-3 py-1.5 no-underline transition-colors hover:bg-[var(--surface-3)] sm:block" style="color: var(--text-secondary)">
            Benchmarks
          </a>
          <a href="/practice/" class="hidden rounded-md px-3 py-1.5 no-underline transition-colors hover:bg-[var(--surface-3)] sm:block" style="color: var(--text-secondary)">
            Practice
          </a>
          <a href="/slides/" class="hidden rounded-md px-3 py-1.5 no-underline transition-colors hover:bg-[var(--surface-3)] sm:block" style="color: var(--text-secondary)">
            Slides
          </a>
          <a href="/support/" class="hidden rounded-md px-3 py-1.5 no-underline transition-colors hover:bg-[var(--surface-3)] sm:block" style="color: var(--text-secondary)">
            Support
          </a>
          <a href={REPO_URL} class="hidden rounded-md px-3 py-1.5 no-underline transition-colors hover:bg-[var(--surface-3)] sm:block" style="color: var(--text-secondary)" rel="noopener">
            GitHub
          </a>
          <ThemeToggle />
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-24 border-t" style="border-color: var(--border)">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-10 text-sm sm:flex-row sm:items-center sm:justify-between" style="color: var(--text-muted)">
        <div>
          <p>A free, open-source book. Read it all right here — the whole thing lives on this site.</p>
          <p class="mt-1.5">Every benchmark runs in your browser. Nothing is uploaded, and no result leaves the tab.</p>
        </div>
        <a
          href={REPO_URL}
          rel="noopener"
          class="inline-flex shrink-0 items-center gap-2 rounded-lg border px-4 py-2 no-underline transition-colors hover:bg-[var(--surface-2)]"
          style="border-color: var(--border-strong); color: var(--text-primary)"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49l-.01-1.9c-2.78.62-3.37-1.2-3.37-1.2-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.56 2.35 1.11 2.92.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.74-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.35 9.35 0 015 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.71 1.03 1.62 1.03 2.74 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.6.69.49A10.02 10.02 0 0022 12.25C22 6.58 17.52 2 12 2z"/></svg>
          Fork it on GitHub — contributions welcome
        </a>
      </div>
    </footer>

    {/* Mermaid is ~1MB; only pull it in on pages that actually contain a diagram. */}
    <script>
      const diagrams = document.querySelectorAll('pre.mermaid');
      if (diagrams.length > 0) {
        const { default: mermaid } = await import('mermaid');
        const dark =
          document.documentElement.dataset.theme === 'dark' ||
          (!document.documentElement.dataset.theme &&
            matchMedia('(prefers-color-scheme: dark)').matches);
        mermaid.initialize({
          startOnLoad: false,
          theme: dark ? 'dark' : 'neutral',
          fontFamily: 'ui-sans-serif, system-ui, sans-serif',
        });
        await mermaid.run({ nodes: Array.from(diagrams) as HTMLElement[] });
      }
    </script>
  </body>
</html>
